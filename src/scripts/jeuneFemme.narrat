jeuneFemmeIdle:
  play sound nope
  var label (shift $data.idle.jeuneFemme)
  push $data.idle.jeuneFemme $label
  talk jeuneFemme idle $label
  narrate "Elle ne semble plus vouloir discuter avec vous… pour l'instant." 0 true







/////////////////////////////////////////////ITEMS/////////////////////////////////////////////////////
/////////////// ne pas changer le nom des labels, on y accède hors de la fonction talk ///////////////////////////////////////

jeuneFemmepassReçu:
  set data.logs.passDonné jeuneFemme
  "L'objet passe à travers la toile et disparaît."
  talk jeuneFemme idle "Êtes-vous sûr ? Ce pass vous appartient."
  talk jeuneFemme idle "Il représente certainement beaucoup plus pour vous que pour moi."
  choice
    ""
    "C'est à vous de l'avoir."
      talk player idle "J'ai tiré ce que je devais de ce pass."
      talk player idle "Gardez-le, ça me fait plaisir. Peut-être pourra-t-il raviver certains de vos souvenirs également."
    "Peu importe qui le garde."
      talk player idle "Je ne pense pas que cela change quoi que ce soit que je le garde ou non."
      talk jeuneFemme idle "Quoi qu'il en soit…" 
  talk jeuneFemme idle "Merci infiniment !"

jeuneFemmedolipraneReçu:
  set data.logs.dolipraneDonné jeuneFemme
  talk jeuneFemme idle "Merci infiniment !"

jeuneFemmecadresReçu:
  set data.logs.cadresDonnés jeuneFemme
  talk jeuneFemme idle "Merci infiniment !"

jeuneFemmetorcheReçu:
  set data.logs.torcheDonnée jeuneFemme
  talk jeuneFemme idle "Merci infiniment !"

jeuneFemmeextincteurReçu:
  set data.logs.extincteurDonné jeuneFemme
  talk jeuneFemme idle "Merci infiniment !"

jeuneFemmelivretReçu:
  set data.logs.livretDonné jeuneFemme
  talk jeuneFemme idle "Merci infiniment !"

//////////////////////////////////////////////SCENAR/////////////////////////////////////////////////////

jeuneFemmeTorche:
  talk jeuneFemme idle "Yerbol ! Là, encore un objet par terre !"


jeuneFemmeTorcheObtenue:
  talk jeuneFemme idle "Quel objet était-ce cette fois-ci ?"
  if $data.logs.torcheVue
    push $data.logs.dialogs jeuneFemmeTorcheObtenue2
    
    jump torcheSuite
  else:
    talk player idle "Il faut que je l'examine avant de pouvoir vous en dire plus."
  
jeuneFemmeTorcheObtenue2:
  talk jeuneFemme idle "Alors, cet objet ramassé ? Ne me faites pas languir !"
  push $data.logs.dialogs jeuneFemmeTorcheObtenue
  jump torcheSuite

torcheSuite:
  if (!(includes $data.logs.dialogs jeuneFemmeTorcheObtenue2))
    push $data.logs.dialogs jeuneFemmeTorcheObtenue
  talk player idle "C'est une petite lampe torche."


jeuneFemmeLivret:
  talk jeuneFemme idle "Encore un objet. Combien en reste-t-il, selon vous ?"


jeuneFemmeLivretObtenu:
  talk jeuneFemme idle "Qu'était-ce, cette fois ?"
  if $data.logs.livretVu
    push $data.logs.dialogs jeuneFemmeLivretObtenu2
    jump livretSuite
  else:
    talk player idle "Je vais regarder ça."
  
jeuneFemmeLivretObtenu2:
  talk jeuneFemme idle "Je vous ai vu examiner le dernier objet. Dites-moi vite ce que c'était !"
  push $data.logs.dialogs jeuneFemmeLivretObtenu
  jump livretSuite

livretSuite:
  if (!(includes $data.logs.dialogs jeuneFemmeLivretObtenu2))
    push $data.logs.dialogs jeuneFemmeLivretObtenu
  talk player idle "Un livret d'exposition."



jeuneFemmeHello:
  talk jeuneFemme idle "Oh ! Mes salutations."
  choice
    ""
    "\"Oui. Bonjour. Veuillez agréer mes salutations distinguées. Qu'est-ce que c'est que cette blague ?\""
      talk jeuneFemme idle "…vous êtes dérouté. Croyez bien que je le comprends."
      talk jeuneFemme idle "Ravie néanmoins de faire votre connaissance."
    "Ignorer la jeune femme."
      "Vous restez muet."
      "Un silence inconfortable s'installe."
      "La jeune femme soupire."
      talk jeuneFemme idle "Ce n'est pas que je veuille vous forcer à faire la conversation, mais…"
    "\"Qui a parlé ?\""
      talk jeuneFemme idle "…c'est moi, monsieur. Est-ce que je peux vous demander de rester ouvert d'esprit, sans quoi notre conversation va être difficile ?"
  jump jeuneFemmeHello2

jeuneFemmeHello2 id:
  choice
    ""
    "\"Vous êtes un <i>tableau</i>. Une peinture. Des pigments sur une toile. La représentation abstraite d'une personne. Est-ce que j'ai bien abordé la notion d'\"objet inanimé non doué de parole\" ? Je ne suis pas sûr que l'idée soit bien passée.\""
      talk jeuneFemme idle "C'est, ma foi, tout à fait vrai. Je suis une peinture."
      choice
        ""
        "\"Ah, je vois. C'est un rêve. Un rêve fiévreux probablement dû à une consommation excessive de substances plus ou moins identifiées ; je fais un bon vieux cauchemar. Sans vouloir vous offenser.\""
          talk jeuneFemme idle "Je ne le suis nullement, mais je vous assure de ma réalité."
          talk jeuneFemme idle "Je conviens cependant ne pas disposer de moyens propres à vous en convaincre."
          jump jeuneFemmeTableau
        "\"Mais est-ce que vous êtes <i>vraiment</i> un tableau ?\" - Vous vous approchez de la toile pour la décrocher du mur."
          talk jeuneFemme idle "Je vous en prie, non !"
          "Sa voix trahit une émotion sincère."
          talk jeuneFemme idle "S'il vous plaît, ne me décrochez pas… si vous saviez comme le temps est long, appuyée à l'envers contre un mur ou carrément retournée au sol. Être solidement accrochée, c'est devenu un critère de bien-être absolument essentiel pour moi."
          talk jeuneFemme idle "Je ne sais pas comment vous convaincre de me laisser en place. Un peu de vue et un morceau de ciel bleu, cela fait si longtemps que je n'ai pas eu droit à de telles conditions de vie !"
          "Vous avez de toute façon pu constater que rien ne se cache derrière la toile. Il faut vous rendre à l'évidence : vous menez une conversation avec un personnage peint."
          jump jeuneFemmeTableau
    "\"De grâce, dites-moi que vous savez qui se cache derrière cette porte à côté. Sa voix est <i>positivement</i> inquiétante.\""
      talk jeuneFemme idle "Je n'aurais rien dit si vous n'aviez pas abordé le sujet. J'ai un mauvais pressentiment au sujet de cet individu."
      jump jeuneFemmeIndividu
    "\"Très bien. Je suis prêt à ignorer l'éléphant dans la pièce, pourvu que vous me disiez où nous sommes.\""
      talk jeuneFemme idle "Je ne saurais malheureusement vous le dire."
      talk jeuneFemme idle "C'est étrange… je me suis soudainement retrouvée accrochée à ce mur, mais sans y avoir été transportée."
      "Elle a l'air sincèrement embêtée pour vous."
      talk jeuneFemme idle "Ces choses-là ne m'affectent pas autant que vous. Du moment que je suis au mur, savoir où je me trouve n'est généralement pas une préoccupation majeure pour moi. Ce n'est pas comme si je pouvais me lever et aller faire du tourisme."
      jump jeuneFemmeHello2 true
    END "\"Est-ce que vous savez qui je suis ?\"" if (|| $id $data.debug)
      talk jeuneFemme idle "Je suis navrée. Nous ne nous connaissons pas et je ne vous ai jamais vu auparavant."
      talk jeuneFemme idle "Vous pourriez peut-être aller voir ce qui se passe plus loin sur votre droite ? Il en vient par moments un raffut de tous les diables. Peut-être trouverez-vous quelqu'un à même de vous répondre."
      set_button droite true


jeuneFemmeTableau:
  choice
    ""
    "\"J'imagine que vous avez gagné la parole en vous trouvant transportée dans cet endroit curieux ?\""
      talk jeuneFemme idle "J'ai le sentiment d'avoir toujours pu parler, mais pas de souvenir précis de le faire. Peut-être ne l'ai-je jamais fait, faute d'interlocuteur attentif."
      talk jeuneFemme idle "Et peut-être les visiteurs des musées ne sont-ils pas dignes d'un échange sincère avec moi."
      jump jeuneFemmeTableau
    "\"Une toile parlante… Riche, je vais être riche !\""
      talk jeuneFemme idle "Allons, nous savons tous les deux que jamais personne ne vous croira."
      talk jeuneFemme idle "Et puis, je ne sais pas exactement à qui vous pensez pouvoir me vendre, ici."
      jump jeuneFemmeTableau
    BACK "\"Ok, vous êtes un tableau. Cool. Je suis si peu affecté par la situation que je peux passer à autre chose l'air de rien.\""
      jump jeuneFemmeHello2 true
        
jeuneFemmeIndividu:
  choice
    ""
    "\"On ne peut pas faire confiance à quelqu'un qui se cache ainsi.\""
      talk jeuneFemme idle " Il a peut-être une bonne raison de le faire… mais j'aimerais que notre arrivée en ce lieu se déroule dans des circonstances moins étranges."
      choice
        ""
        "\"J'aimerais que notre arrivée en ce lieu ne se soit pas produite du tout.\""
          talk jeuneFemme idle "Certes… mais nous allons devoir faire avec, il semble bien."
          jump jeuneFemmeIndividu
    "\"Il a peut-être une bonne raison de ne pas se montrer. Il est peut-être <i>vraiment</i> moche.\""
      "Un rire."
      talk jeuneFemme idle "Allons, ne tombons pas dans ces considérations. La beauté est subjective, et ne préjuge pas du caractère."
      jump jeuneFemmeIndividu
    "\"Pensez-vous qu'il est prisonnier de cet endroit ? Ou est-il celui qui nous a enfermé ici ?\""
      talk jeuneFemme idle "Encore une question à laquelle je ne peux répondre.\" - Vous jureriez presque qu'elle arbore un sourire las. \"J'espère que c'est la première option. L'alternative serait inquiétante."
      jump jeuneFemmeIndividu
    BACK "\"Oublions ce sinistre personnage pour l'instant.\""
      jump jeuneFemmeHello2
      


jeuneFemmeEndroit:
  talk jeuneFemme idle "En avez-vous appris plus sur ce lieu ?"
  jump jeuneFemmeEndroit2

jeuneFemmeEndroitBis:
  talk jeuneFemme idle "Passons. Vous avez appris autre chose ?"
  jump jeuneFemmeEndroit2 0

jeuneFemmeEndroit2 count:
  choice 
    ""
    "\"Pas grand chose de nouveau. Tout ce que j'ai pu constater, c'est que mes déplacements sont fortement limités, ici.\""
      talk jeuneFemme idle "C'est à dire ?"
      choice
        ""
        "\"Je veux <i>m'en aller</i> et je ne le peux pas, je pensais pourtant que c'était clair.\""
          talk jeuneFemme idle "Excusez-moi. Oui, je l'ai bien compris, bien sûr."
        "\"Je n'ai accès qu'à cette cour et à un petit jardin, de l'autre côté de la porte.\""
          talk jeuneFemme idle "J'imagine que ça doit être frustrant pour vous."
          "Elle soupire."
          talk jeuneFemme idle "Dans le dernier musée où j'étais exposée, il y avait une grande fresque en face de moi. Elle représentait des enfants sur une plage. Je les ai si longtemps enviés ! Les rafales de vent qui soufflent, le soleil qui tape, les embruns qui s'envolent… Et surtout, la place de marcher en ligne droite vers l'horizon…"
          set data.logs.plage true
      add count 1
      jump jeuneFemmeEndroitBis $count
    "\"Si on veut. Il semblerait que je sois la seule personne physique présente ici.\""
      talk jeuneFemme idle "La seule personne physique ? Cela veut-il dire que vous avez rencontré d'autres tableaux que moi ?"
      choice
        ""
        "\"J'ai rencontré une danseuse de flamenco et son public.\""
          set data.logs.jeuneFemmeKnowsDancer true
          talk jeuneFemme idle "Incroyable ! C'est donc là la source de cette musique dont j'entends les échos ?"
          talk jeuneFemme idle "Oh, s'il vous plaît, voulez-vous parler de moi à ces gens ? J'ai furieusement besoin de compagnie. Cela m'aiderait à me sentir mieux"
          choice
            ""
            "\"Bien sûr.\""
              talk jeuneFemme idle "Merci mille fois !"
            "\"Je ne suis pas sûr que ce soit une bonne idée.\""
              talk jeuneFemme idle "Pourquoi donc ? Est-ce que vous…"
              talk jeuneFemme idle "Oh. Vous voulez dire qu'il vaut mieux garder nos cartes en main tant que nous n'en savons pas plus sur la situation ?"
              "Sa déception est palpable."
              talk jeuneFemme idle "…je comprends, bien sûr. Je comprends."          
          add count 1
          jump jeuneFemmeEndroitBis $count
        "\"Est-ce une pointe de jalousie que j'entends là ?\""
          talk jeuneFemme idle "Non. Non ? Pas du tout. Je ne suis pas jalouse. Vous pouvez bien parler à qui vous voulez, si vous croyez que ça m'atteint. Moi, jalouse ? Ça fait longtemps que je n'ai pas entendu ça, tiens."
          add count 1
          jump jeuneFemmeEndroitBis $count
        "\"Non, je voulais inssiter sur le fait que je suis la seule personne à pouvoir me balader par ici.\""
          talk jeuneFemme idle "Ah, mais vous n'êtes peut-être pas une personne physique pour autant."
          choice
            ""
            "\"Comment ça ?\""
              talk jeuneFemme idle "Si nous sommes, disons, au purgatoire, ou bien dans une simulation informatique, alors vous pourriez <i>techniquement</i> vous balader sans être à proprement parler une personne physique."
              "Est-ce qu'elle se moque de vous ?"
              choice
                ""
                "\"Vous pensez sérieusement que je pourrais êtré envoyé dans un endroit aussi vulgaire que le purgatoire ? Je peux vous dire que Saint-Pierre donnera un grand coup de pied dans les portes du paradis pour me laisser passer ! Traitement VIP et bouteilles de champagne incluses !\""
                  "Elle soupire."
                  talk jeuneFemme idle "Je crois que c'est l'un des grands messages de toutes les religions, que personne n'est au-dessus d'un peu d'amélioration personnelle. Combien de personnes croient mériter la vie éternelle alors que vous les verriez bien croupir en enfer ? Finir au purgatoire, au moins, c'est avoir la chance de racheter ses erreurs."
                  choice 
                    ""
                    "\"Je crois bien que le purgatoire est une notion totalement apocryphe.\""
                      if (! $data.logs.jeuneFemmePassObtenu)
                        talk jeuneFemme idle "Vous ne vous souvenez même pas de votre nom. Ne vous vexez pas mais je ne me fierais  pasà votre culture religieuse, à votre place."
                        add count 1
                        jump jeuneFemmeEndroitBis $count
                      else: 
                        talk jeuneFemme idle "Eh bien, on dirait qu'une partie de votre culture religieuse est revenue avec votre nom !"
                        talk jeuneFemme idle "D'autres théories à me soumettre, peut-être sur la transsubstantiation ? Ou l'impact des oeuvres d'Hermès Trismégiste et Zoroastre sur le gnosticisme ?"
                        add count 1
                        jump jeuneFemmeEndroitBis $count
                "\"Comment savez-vous ce que c'est, une simulation informatique ?\""
                  talk jeuneFemme idle "…"
                  talk jeuneFemme idle "Pour tout vous dire, je ne suis pas bien sûre d'utiliser l'expression correctement. Je vous ressors les mots employés par un visiteur qui avait tenu sous ma toile une conversation passionnée sur les aventures d'un certain Neo. Ce n'étais pas correct dans le contexte ?"
                  choice
                    ""
                    "\"Je ne sais pas si cet endroit est une simulation, mais dans le doute, en effet,appelez-moi Neo.\""
                      wait 0
                    "\"Ça ne ressemble pas à une simulation. Mais appelez-moi Neo quand même.\""
                      wait 0
                  talk jeuneFemme idle "Très bien !"
                  set data.logs.jeuneFemmeNomUtilisé Neo
              add count 1
              jump jeuneFemmeEndroitBis $count
    "\"AAAAAAH, UN TABLEAU QUI PARLE !\" - faire semblant d'avoir oublié votre conversation récente."
      talk jeuneFemme idle "Allons, ce n'est que moi ! \" - la pauvre a l'air absolument effarée. \"Nous venons à peine de discuter !"
      add data.logs.jeuneFemmePranks 1
      set data.logs.jeuneFemmeÉtonnementTableau true
      talk jeuneFemme idle "Reprenez-vous. Vous me parliez de ce que vous avez découvert sur ce lieu…"
      add count 1
      jump jeuneFemmeEndroit2 $count
    END "\"Peu importe ce que j'ai vu ici, j'ai déjà quelques idées.\"" if (|| (== $count 0) $data.debug) 
      jump jeuneFemmeThéories 0 0 0
    END "\"Tout ça me conduit à plusieurs théories possibles…\"" if (|| (> $count 0) $data.debug) 
      jump jeuneFemmeThéories 0 0 0

jeuneFemmeThéories count élu paradis:
  choice
    ""
    "\"Nous pourrions être dans une simulation.\""
      talk jeuneFemme idle "Une simulation ? Mais réalisée par qui, et à quelles fins ?"
      choice
        ""
        "Probablement quelque chose pour sauver l'espèce humaine, ou quelque chose d'au moins aussi important. Ça ne m'étonne pas du tout qu'on m'ait sélectionné come sujet, j'ai toujours su que j'étais appelé à de grandes choses." if (|| (== $élu 0) $élu)
          set élu true
          "Un silence. Vous sentez bien que votre interlocutrice ne sait pas bien quoi vous répondre."
        "Quelqu'un avec beaucoup trop de moyens et de temps libre. Si quelqu'un croit accomplir quelque chose avec moi comme cobaye, il va être sévèrement désappointé." if (|| (== $élu 0) (! $élu))
          set élu false
          talk jeuneFemme idle "Ne vous dévalorisez pas comme ça. Je suis sûre que vous êtes un sujet d'étude tout à fait convenable."
          talk jeuneFemme idle "Bon, vous n'avez pas encore fait grand-chose, mais je suis convaincue que vous avez de grandes choses à offrir."
      add count 1
      jump jeuneFemmeThéories $count $élu $paradis
    "\"Est-ce que vous croyez à la vie après la mort ?\""
      talk jeuneFemme idle "Vous ne voulez certainement pas dire ce que je pense."
      talk jeuneFemme idle "Nous serions… Où exactement, d'ailleurs ? Au paradis ? En enfer ? Ailleurs ?"
      choice
        ""
        "J'ai perdu mes souvenirs et je suis sous la coupe d'une voix maléfique dans un endroit hostile. C'est mon petit coin de paradis !" if (|| (== $paradis 0) (== $paradis 1))
          talk jeuneFemme idle "Je suis heureuse de voir que vous ne vous laissez pas abattre !"
          "Votre ironie lui est clairement passée au-dessus de la tête."
          set paradis 1
        "Pardon, il faut vraiment que je réponde, là ? Enfer. E N F E R. Enfer." if (|| (== $paradis 0) (== $paradis 2))
          talk jeuneFemme idle "Je suis navrée de vous voir faire face à l'adversité de cette façon.\" - elle a l'air sincèrement déçue. \"Je pensais qu'avoir un peu de compagnie adoucirait tout de même quelque peu les choses. J'imagine que ce n'est pas le cas."
          set paradis 2
        "Aucune idée, mais si nous sommes dans l'au-delà, je ne connais pas une seule religion qui ne se soit pas magistralement plantée." if (|| (== $paradis 0) (== $paradis 3))
          set paradis 3
          wait 0
      add count 1
      jump jeuneFemmeThéories $count $élu $paradis
    "\"Je suis probablement quelque part, harnaché dans une camisole de force, bourré de médicaments et ciao bonsoir.\""
      talk jeuneFemme idle "Je doute que vous soyiez resté aussi intelligible et cohérent sous l'influence de médicaments."
      add count 1
      jump jeuneFemmeThéories $count $élu $paradis
    END "Mais maintenant que j'y pense, est-ce que savoir ce qu'il se passe ici est vraiment notre priorité ?" if (> $count 0)
      talk jeuneFemme idle "La réponse ne vous intéresse pas ?"
      choice 
        ""
        "Mon urgence, c'est surtout récupérer mes souvenirs et partir d'ici par quelque moyen que ce soit."
          talk jeuneFemme idle "Espérons que vous pourrez faire les deux."
          talk jeuneFemme idle "Il me semble tout de même que vous serez obligé de dénouer le mystère de ce lieu pour en trouver une sortie."
        
      
      
jeuneFemmeQuestionPosée:
  talk player idle "La personne derrière la porte m'a posé une question étrange… Il était question de chevaux, de tabac et de danse."
  talk jeuneFemme idle "C'est en effet curieux. Il n'y a ni chevaux, ni tabac, ici."
  if $data.logs.jeuneFemmeKnowsDancer
    talk jeuneFemme idle "À la rigueur, il y a la danseuse dont vous m'avez parlé, même si je ne vois pas bien comment elle s'insèrerait dans l'équation. Est-elle juchée sur un cheval ?"
    choice
      ""
      "\"Elle fait des cabrioles sur un paleron à la taille considérable.\""
        talk jeuneFemme idle "Sérieusement ? Je disais ça pour rire. C'est incroyable, les prouesses dont sont capables les personnes dévouées à leur art."
      "\"Bien sûr que non.\""
        talk jeuneFemme idle "…"
        talk jeuneFemme idle "Oui, c'était une question stupide, n'est-ce pas ?"
  choice
    ""
    "\"Du tabac ? Non, il n'y a pas de tabac, ici. Mais dites-moi, quel est cet objet qui produit de la fumée, à vos pieds ?\""
      talk jeuneFemme idle "Ce n'est qu'un petit brûleur à encens. On y met des braises et un combustible aromatique."
      talk jeuneFemme idle "Vous ne pouvez certainement pas le sentir, mais cet ambre gris produit un parfum légèrement musqué qui embaume toute la pièce."
      choice
        ""
        "De l'ambre gris ?"
          talk jeuneFemme idle "C'est une substance extraite des baleines et cachalots. Je n'en sais malheureusement pas beaucoup plus."
          set data.logs.ambreGris true
    "\"Laissons tomber pour l'instant.\""
      wait 0

jeuneFemmeLoupe:
  talk jeuneFemme idle "C'est un étrange outil que vous avez là. On dirait un gros monocle monté sur un tison."
  choice
    ""
    "Vous ne savez pas ce que c'est qu'une loupe ?"
      talk jeuneFemme idle "Non. Je devrais ?"
      choice 
        ""
        "\"C'est un instrument qui permet de grossir ce qu'on regarde.\""
          wait 0
  talk jeuneFemme idle "Vraiment ?"
  talk jeuneFemme idle "Et qu'allez-vous donc faire de cette <i>loupe</i> ?"
  choice
    ""
    END "\"Je ne vois pas de raison de ne pas en faire usage. Il se passe de drôles de choses, ici ; je suis sûr qu'elle ne sert pas qu'à grossir des objets.\""
      talk jeuneFemme idle "Je confesse être également curieuse. Veillez à me tenir informée de ce que vous observez."
    END "\"Je n'ai aucune confiance ni en la personne qui se cache derrière la porte, ni en cet objet. Je ne compte pas y toucher.\""
      talk jeuneFemme idle "J'espère que vous vous ne lasserez pas de nos discussions, alors. Il n'y a guère d'autre occupation en ces lieux."

jeuneFemmeTableaux:
  talk jeuneFemme idle "Je me rends compte que nous sommes passés un peu vite sur un sujet d'importance…"
  talk jeuneFemme idle "J'ai le sentiment que ma nature de tableau doit être un élément important dans notre situation."
  talk jeuneFemme idle "En tout cas, cela fait partie des circonstances extraordinaires qui pourraient certainement nous mettre sur la voie de la solution de ce mystère."
  choice 
    ""
    "\"Je vois ce que vous voulez dire. Quitte à me donner des interlocuteurs, pourquoi en faire des peintures ?\""
      talk jeuneFemme idle "Je ne voyais pas vraiment les choses comme ça."
    "\"Je ne sais pas. Je ne me formalise pas vraiment du reste de l'environnement, ici. Est-ce que ce ciel bleu est censé avoir une signification particulière ?\""
      talk jeuneFemme idle "Enfin, vous ne pouvez pas comparer une personne vivante qui est en mesure de vous parler avec un élément de décor ! Et puis, il y a une question plus large."
  "Elle ménage une pause de quelques secondes."
  talk jeuneFemme idle "Et si vous n'étiez pas vraiment le protagoniste de cette situation ?"
  "Ses mots vous font l'effet d'un coup de poing."
  choice 
    ""
    "\"Que voulez-vous dire par là ? La voix derrière la porte s'adresse à moi depuis mon réveil. Elle m'a donné une mission et un outil pour accomplir celle-ci !\""
      talk jeuneFemme idle "J'ai horreur de dire les choses en ces termes, mais cela ne signifie pas que vous soyiez la raison d'être de cet endroit. Vous pourriez être une sorte de… d'<i>adjuvant</i>. Un agent libre destiné à remplir un rôle, mais pas nécessairement le sujet principal de l'histoire."
    "\"…Je me suis moi-même posé la question.\""
      wait 0
  talk jeuneFemme idle "Cette situation semble si simple, n'est-ce pas ? Les lieux qui vous sont accessibles sont méticuleusement cadrés, on a mis en scène un jeu suspect à un seul levier d'action, vous êtes confortés dans votre rôle de seul personnage libre de ses mouvements ici…"
  talk jeuneFemme idle "Tout cela destiné à vous faire comprendre quelque-chose, mais on ne peut pas simplement vous l'expliquer ? On dirait que vous êtes poussé à accomplir Dieu seul sait quoi avec cette loupe."
  choice
    ""
    "\"Le personnage principal de cette mascarade serait donc… Qui exactement ? Vous ?\""
      wait 0
  if $data.logs.jeuneFemmeKnowsDancer
    var réplique "Ou bien cette danseuse dont vous m'avez parlé. "
  else:
    var réplique ""
  talk jeuneFemme idle "Je l'ignore. Peut-être. %{$réplique}Ou bien encore cet individu énigmatique." // on ajoute la phrase concernant la danseuse seulement si la jeune femme connaît son existence
  choice
    ""
    "\"Je garderai ça en tête.\""
      wait 0
  choice
    ""
    "\"En parlant de tableaux, pouvez-vous m'en dire plus sur vous ?\""
      talk jeuneFemme idle "Que voulez-vous savoir ?"
      jump jeuneFemmeTableauxDétails


jeuneFemmeTableauxDétails:
  choice 
    ""
    "\"J'aimerais savoir qui est l'artiste qui vous a peint.\""
      talk jeuneFemme idle "Je ne sais pas ce que je pourrais vous dire d'utile. C'était un homme qui portait en général un costume noir. Sa barbe était broussailleuse, et il travaillait par longues sessions, du matin au soir."
      talk jeuneFemme idle "C'était un artiste professionnel, cela au moins est certain. Il avait pour habitude de montrer ses travaux en cours à divers visiteurs qui semblaient tous de nationalités et de langues différentes."
    "\"À quelle date votre toile a-t-elle été réalisée ?\""
      talk jeuneFemme idle "C'était il y a si longtemps, autant me demander si je suis capable de compter le nombre de grains de sable sur une plage !"
      talk jeuneFemme idle "J'imagine qu'un expert serait capable de me dater sur tout un tas de critères de style et de technique, mais nous n'en avons pas sous la main. À moins que vous m'ayiez caché un talent pour la chose."
    "\"Quelle technique a été employée pour vous peindre ?\""
      talk jeuneFemme idle "Si je me fie aux mouvements de l'air sur ma peau et au frottement de mon vêtement, je dirais… peinture à l'huile ? "
    "\"Je ne suis pas dupe. Vous avez été réalisée par IA et imprimée sur une feuille A0 Lyreco, n'est-ce pas ?\""
      talk jeuneFemme idle "C'est certainement vrai !"
      "Il est clair qu'elle n'a pas compris un mot de votre phrase."
    END "\"Assez de questions. Vous êtes une personne avec son identité propre, je ne vais pas vous traiter comme une toile inanimée.\""
      jump jeuneFemmeTableauxFin
  jump jeuneFemmeTableauxDétails
  
jeuneFemmeTableauxFin:
  talk jeuneFemme idle "Cela ne me dérange pas, vous savez. Mais j'apprécie l'intention."

jeuneFemmeGaulli:
  talk jeuneFemme idle "Vous ai-je déjà parlé de ma peinture préférée ?"
  talk jeuneFemme idle "Il s'agit du Triomphe du Nom de Jésus, d'Il Baciccio Gaulli."
  run displayTableau gaulli
  wait 5000
  run cacherTableau
  run boutonTableau gaulli
  set data.logs.gaulli true


jeuneFemmeLivret:
  talk jeuneFemme idle "Qu'est-ce que c'est que ça, par terre ?"


jeuneFemmeLivretObtenu:
  talk jeuneFemme idle "Je vous ai vu ramasser un petit objet, juste derrière le mur. Puis-je vous demander ce que c'était ?"
  if $data.logs.livretVu
    push $data.logs.dialogs jeuneFemmeLivretObtenu2
    jump livretSuite
  else:
    talk player idle "Il faut que je l'examine avant de pouvoir vous en dire plus."

jeuneFemmeLivretObtenu2:
  talk jeuneFemme idle "Alors, cet objet ?"
  push $data.logs.dialogs jeuneFemmeLivretObtenu
  jump livretSuite

livretSuite:
  if (!(includes $data.logs.dialogs jeuneFemmeLivretObtenu))
    push $data.logs.dialogs jeuneFemmeLivretObtenu
  talk jeuneFemme idle "Parlons du livret… une autre fois."

jeuneFemmeTorche:
  talk jeuneFemme idle "Qu'est-ce que c'est que ça, par terre ?"


jeuneFemmeTorcheObtenue:
  talk jeuneFemme idle "Je vous ai vu ramasser un petit objet, juste derrière le mur. Puis-je vous demander ce que c'était ?"
  if $data.logs.torcheVue
    push $data.logs.dialogs jeuneFemmeTorcheObtenue2
    jump torcheSuite
  else:
    talk player idle "Il faut que je l'examine avant de pouvoir vous en dire plus."

jeuneFemmeTorcheObtenue2:
  talk jeuneFemme idle "Alors, cet objet ramassé derrière le mur ?"
  push $data.logs.dialogs jeuneFemmeTorcheObtenue
  jump torcheSuite

torcheSuite:
  if (!(includes $data.logs.dialogs jeuneFemmeTorcheObtenue))
    push $data.logs.dialogs jeuneFemmeTorcheObtenue
  talk jeuneFemme idle "Parlons de la torche… une autre fois."




jeuneFemmePass:
  talk jeuneFemme idle "Qu'est-ce que c'est que ça, par terre ?"

jeuneFemmePassObtenu:
  talk jeuneFemme idle "Je vous ai vu ramasser un petit objet, juste derrière le mur. Puis-je vous demander ce que c'était ?"
  if $data.logs.passVu
    push $data.logs.dialogs jeuneFemmePassObtenu2
    jump passSuite
  else:
    talk player idle "Il faut que je l'examine avant de pouvoir vous en dire plus."
  
jeuneFemmePassObtenu2:
  talk jeuneFemme idle "Alors, cet objet ramassé derrière le mur ?"
  push $data.logs.dialogs jeuneFemmePassObtenu
  jump passSuite
  
passSuite:
  if (!(includes $data.logs.dialogs jeuneFemmePassObtenu))
    push $data.logs.dialogs jeuneFemmePassObtenu
  choice
    ""
    "C'était mon badge."
      talk player idle "Il s'agissait du badge qui donne accès à mon lieu de travail. Du diable si je sais comment il s'est retrouvé là."
      talk jeuneFemme idle "Votre lieu de travail… Est-ce étrange de ma part de souhaiter avoir un emploi ? Je n'ai jamais eu pour autre responsabilité que de me comporter en fille de bonne famille, voyez-vous. Mon père tenait mordicus à ce que les fruits de son labeur me permettent de ne jamais me soucier d'argent."
      set data.logs.jeuneFemmePère true
    "Rien d'important."
      talk player idle "Oh, rien d'important. Je crois que votre voisin, derrière la porte, s'amuse à mes dépens."
      talk jeuneFemme idle "Je confesse ne pas savoir quoi penser de ce curieux personnage. Sa voix me paraît parfois familière, mais sans savoir à quoi il ressemble…"
      talk jeuneFemme idle "Cela dit, j'ai l'habitude de ne pouvoir qu'entendre mes voisins. On ne me demande pas souvent où je souhaiterais que mon cadre soit accroché, voyez-vous."
      set data.logs.cadreAccrochage true

  talk jeuneFemme idle "Voulez-vous bien revenir me parler de ce que vous verrez par ici ?"
  talk player idle "Bien sûr."
  talk player idle "Au fait, mon nom est Yerbol. J'aurais dû vous le donner plus tôt, mais il vient à peine de me revenir."
  talk jeuneFemme idle "Enchantée, Yerbol. J'ai peur de ne pas avoir de nom à vous offrir en retour."

  choice 
    ""
    "Vous voulez un nom ?"
      talk player idle "Est-ce que… est-ce que vous voulez en choisir un ? Ne serait-ce que pour le temps que nous avons à passer ici ?"
      talk jeuneFemme idle "Pourquoi pas. Quel nom trouveriez vous convenable ?"
      talk jeuneFemme idle "Tout sauf Lucette. Je ne saurais vous dire pourquoi, mais j'ai ce nom en horreur."
      choice
        ""
        "Augustine."
          talk player idle "Disons… Augustine."
          talk jeuneFemme idle "C'est le nom d'une sainte, n'est-ce pas ? "
          talk player idle "Je crois que si on cherche bien, tout prénom mène à une sainte ou un saint."
          "Sa voix se fait rieuse."
          talk jeuneFemme idle "Augustine… Cela ressemble au type de nom qu'aurait pu me donner mon père. Ça me plaît !"
          set data.logs.jeuneFemmePère true
          var name Augustine
        "TurboMegatron3000."
          talk player idle "Je pense que TurboMegatron3000 vous irait à merveille."
          talk jeuneFemme idle "Je ne suis pas familière de ce prénom. A-t-il une signification particulière ?"
          choice 
            ""
            "Oui."
              talk player idle "C'est un nom dérivé de celui d'un personnage de fiction bien connu. Pensez à tous ces parents qui nomment leurs enfants comme des personnages de Shakespeare ; il s'agit du même procédé."
              talk jeuneFemme idle "… Il y a des parents qui nomment leurs enfants comme des personnages de Shakespeare ?"
              talk player idle "Bien sûr ! Enfin, c'est très probable. Pas que j'en connaisse, mais ça doit se trouver."
              talk player idle "Si on cherche bien."
              talk player idle "Tous ces Iago et ces Titania qui se promènent dans la nature."
            "Non."
              talk player idle "C'est juste joli et ça roule tout seul sous la langue. Il faut savoir être créatif, parfois."
              talk player idle "Et puis, si on réfléchit bien, tous les noms ont été inventés à un moment ou un autre."
            "Il faut que j'y aille !"
              talk player idle "Veuillez m'excuser, mais je n'ai pas de temps à perdre."
          var name TurboMegatron3000
        "J'ai une idée bien précise en tête."
          var name (text_field "Quel nom donner à la jeune femme ?")
          if (== $name "Lucette")
            talk jeuneFemme idle "…Vous vous moquez de moi ?"
            set data.logs.lucette true
            talk jeuneFemme idle "Si c'est comme ça, oublions cette histoire de nom."
            "Vous l'avez clairement vexée."
            return 0
          talk jeuneFemme idle "%{$name}… Je dois dire que ça me plaît bien."
      set config.characters.characters.jeuneFemme.name $name // changement du nom dans la config
      set data.gameState.jeuneFemmeName $name // exclusivement pour le label reload
      set data.logs.jeuneFemmeNomChangé true
          
    "On n'a pas vraiment besoin d'avoir un nom."
      talk player idle "Nous sommes la somme de nos expériences, de nos joies et de nos peines ; nos noms ne sont que des détails insignifiants en comparaison."
      "Votre interlocutrice glousse."
      talk jeuneFemme idle "Je ne m'attendais pas à des considérations philosophiques. Mais vous avez raison, ce n'est pas très important."


//////////////////////////////////////////////FLUFF/////////////////////////////////////////////////////



jeuneFemmeDancer:
  talk jeuneFemme idle "Avez-vous identifié la source de cette musique endiablée ?"
  choice
    ""
    "Il s'agit d'une autre peinture, de l'autre côté de la porte. Une danseuse se livre à une représentation devant un public qui scande et l'acclame."
      talk jeuneFemme idle "Je comprends mieux."
      talk jeuneFemme idle "J'aime beaucoup la musique, voyez-vous, mais je ne suis pas familière de ce style."
      talk jeuneFemme idle "J'aimerais pouvoir voir cette danseuse de mes propres yeux."
      set data.logs.jeuneFemmeKnowsDancer true
    "Je n'ai malheureusement pas pu le faire. Il n'y a que vous, moi, et cette mystérieuse porte, ici."
      set data.logs.jeuneFemmeKnowsDancer false
  
jeuneFemmeRotate:
  talk jeuneFemme idle "WHEEEEEEEE"
  animate .ambergris rotate

jeuneFemmeNom:
  talk jeuneFemme idle "Parlons de nos noms !"
  
jeuneFemmeAmnésie:
  talk jeuneFemme idle "Parlons de votre amnésie !"

jeuneFemmeUnknown:
  talk jeuneFemme idle "Parlons de ce voisin bizarre !"

jeuneFemmeYerbol:
  talk jeuneFemme idle "Parlons de votre prénom !"
  
//////////////////////////////////////////////TRIGGERS/////////////////////////////////////////////////////


jeuneFemmePassToDancer:
  talk jeuneFemme idle "Méchant ! Moi aussi je voulais ce pass !"

jeuneFemmeDolipraneToDancer:
  talk jeuneFemme idle "Méchant ! Moi aussi je voulais ces dolipranes !"